@model List<InterviewQuestionBank.Models.Question>
@{
    ViewData["Title"] = "Browse Questions";
    var categories = ViewBag.Categories as List<InterviewQuestionBank.Models.Category>;
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">
            <i class="fas fa-graduation-cap me-3"></i>Interview Question Library
        </h1>
        <p class="hero-subtitle">Master your .NET interviews with our comprehensive question bank. Search, practice, and track your progress.</p>
        <div class="d-flex gap-3 align-items-center flex-wrap">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="badge badge-primary badge-lg">
                    <i class="fas fa-book"></i>
                    @Model.Count Questions
                </div>
                <div class="badge badge-info badge-lg">
                    <i class="fas fa-layer-group"></i>
                    @(categories?.Count ?? 0) Categories
                </div>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-lg" style="background: white; color: var(--brand-primary); box-shadow: var(--shadow-lg);">
                    <i class="fas fa-plus-circle me-2"></i>Create Question
                </a>
            }
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Search and Filter Section -->
    <div class="search-container">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="search-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text" name="searchTerm" class="search-input" placeholder="Search questions by keyword..." value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select">
                        <option value="">📚 All Categories</option>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="difficulty" class="form-select">
                        <option value="">📊 All Levels</option>
                        <option value="Beginner" selected="@(ViewBag.Difficulty == "Beginner")">✅ Beginner</option>
                        <option value="Intermediate" selected="@(ViewBag.Difficulty == "Intermediate")">⚡ Intermediate</option>
                        <option value="Advanced" selected="@(ViewBag.Difficulty == "Advanced")">🔥 Advanced</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-2"></i>Filter
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Questions Grid -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var question in Model)
            {
                <div class="col-md-6 col-lg-4 fade-in">
                    <div class="question-card" onclick="location.href='@Url.Action("Details", new { id = question.Id })'">
                        <!-- Card Header -->
                        <div class="question-card-header">
                            @if (question.QuestionNumber.HasValue)
                            {
                                <span class="question-number-badge">
                                    <i class="fas fa-hashtag"></i> Question @question.QuestionNumber
                                </span>
                            }
                            <div class="d-flex gap-2">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button" class="btn-icon btn-favorite @(ViewBag.FavoriteQuestionIds != null && ((List<int>)ViewBag.FavoriteQuestionIds).Contains(question.Id) ? "active" : "")"
                                            onclick="event.stopPropagation(); toggleFavorite(@question.Id, this)">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Question Content -->
                        <h3 class="question-title">@question.Title</h3>

                        <!-- Badges -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @switch (question.Difficulty)
                            {
                                case InterviewQuestionBank.Models.DifficultyLevel.Beginner:
                                    <span class="badge badge-beginner">
                                        <i class="fas fa-seedling"></i> Beginner
                                    </span>
                                    break;
                                case InterviewQuestionBank.Models.DifficultyLevel.Intermediate:
                                    <span class="badge badge-intermediate">
                                        <i class="fas fa-bolt"></i> Intermediate
                                    </span>
                                    break;
                                case InterviewQuestionBank.Models.DifficultyLevel.Advanced:
                                    <span class="badge badge-advanced">
                                        <i class="fas fa-fire"></i> Advanced
                                    </span>
                                    break;
                            }

                            @if (question.Category != null)
                            {
                                <span class="badge badge-category">
                                    <i class="fas fa-folder"></i> @question.Category.Name
                                </span>
                            }

                            @if (ViewBag.CompletedQuestionIds != null && ((List<int>)ViewBag.CompletedQuestionIds).Contains(question.Id))
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-check-circle"></i> Completed
                                </span>
                            }
                        </div>

                        <!-- Content Preview -->
                        @if (!string.IsNullOrWhiteSpace(question.Content))
                        {
                            <p class="card-text">
                                @(question.Content.Length > 120 ? question.Content.Substring(0, 120) + "..." : question.Content)
                            </p>
                        }

                        <!-- View Details Link -->
                        <div class="d-flex align-items-center justify-content-between mt-3 pt-3" style="border-top: 1px solid var(--border-color);">
                            <span style="color: var(--brand-primary); font-weight: 600;">
                                View Details <i class="fas fa-arrow-right ms-2"></i>
                            </span>
                            <small class="text-muted">
                                <i class="far fa-clock me-1"></i>5 min read
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-center mt-5">
            <nav aria-label="Question pagination">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">
                                @i
                            </a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="card" style="max-width: 600px; margin: 0 auto;">
                <div class="card-body py-5">
                    <i class="fas fa-search" style="font-size: 4rem; color: var(--text-muted); margin-bottom: 1.5rem;"></i>
                    <h3 style="color: var(--text-primary); margin-bottom: 1rem;">No Questions Found</h3>
                    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                        Try adjusting your search criteria or filters to find what you're looking for.
                    </p>
                    <a href="@Url.Action("Index")" class="btn btn-primary">
                        <i class="fas fa-redo me-2"></i>Reset Filters
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script>
        // Add fade-in animation to cards
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.question-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
}
