@model List<InterviewQuestionBank.Models.Question>
@{
    ViewData["Title"] = "Browse Questions";
    var categories = ViewBag.Categories as List<InterviewQuestionBank.Models.Category>;
}

<!-- Hero Section -->
<div class="hero hero-gradient-secondary hero-md hero-grid">
    <div class="hero-content hero-centered">
        <h1 class="hero-title">
            <i class="fas fa-graduation-cap"></i>
            Interview Question Library
        </h1>

        <p class="hero-subtitle">
            Master your .NET interviews with our comprehensive question bank. Search, practice, and track your progress.
        </p>

        <div class="flex gap-3 items-center flex-wrap justify-center mt-6">
            <div class="badge badge-white badge-lg">
                <i class="fas fa-book"></i>
                @Model.Count Questions
            </div>
            <div class="badge badge-white badge-lg">
                <i class="fas fa-layer-group"></i>
                @(categories?.Count ?? 0) Categories
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-lg btn-white">
                    <i class="fas fa-plus-circle"></i>
                    Create Question
                </a>
            }
        </div>
    </div>
</div>

<div class="container py-8">
    <!-- Search and Filter Section -->
    <div class="card mb-8">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                    <div class="md:col-span-5">
                        <div class="form-group">
                            <label for="searchTerm" class="form-label">
                                <i class="fas fa-search"></i> Search Questions
                            </label>
                            <input type="text"
                                   name="searchTerm"
                                   id="searchTerm"
                                   class="form-control form-control-icon-left"
                                   placeholder="Search by keyword, topic, or technology..."
                                   value="@ViewBag.SearchTerm">
                        </div>
                    </div>

                    <div class="md:col-span-3">
                        <div class="form-group">
                            <label for="categoryId" class="form-label">
                                <i class="fas fa-folder"></i> Category
                            </label>
                            <select name="categoryId" id="categoryId" class="form-control">
                                <option value="">All Categories</option>
                                @if (categories != null)
                                {
                                    foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <div class="form-group">
                            <label for="difficulty" class="form-label">
                                <i class="fas fa-signal"></i> Difficulty
                            </label>
                            <select name="difficulty" id="difficulty" class="form-control">
                                <option value="">All Levels</option>
                                <option value="Beginner" selected="@(ViewBag.Difficulty == "Beginner")">Beginner</option>
                                <option value="Intermediate" selected="@(ViewBag.Difficulty == "Intermediate")">Intermediate</option>
                                <option value="Advanced" selected="@(ViewBag.Difficulty == "Advanced")">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <div class="md:col-span-2 flex items-end">
                        <button type="submit" class="btn btn-primary w-full">
                            <i class="fas fa-filter"></i>
                            Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Questions Grid -->
    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            @foreach (var question in Model)
            {
                <div class="card card-question card-interactive" onclick="location.href='@Url.Action("Details", new { id = question.Id })'">
                    <!-- Card Header -->
                    <div class="card-header flex items-center justify-between">
                        @if (question.QuestionNumber.HasValue)
                        {
                            <span class="badge badge-soft-primary">
                                <i class="fas fa-hashtag"></i> Q@question.QuestionNumber
                            </span>
                        }
                        <div class="flex gap-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <button type="button"
                                        class="btn btn-icon btn-ghost-danger @(ViewBag.FavoriteQuestionIds != null && ((List<int>)ViewBag.FavoriteQuestionIds).Contains(question.Id) ? "active" : "")"
                                        onclick="event.stopPropagation(); toggleFavorite(@question.Id, this)"
                                        aria-label="Toggle favorite">
                                    <i class="fas fa-heart"></i>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body">
                        <h3 class="card-title">@question.Title</h3>

                        <!-- Badges -->
                        <div class="flex flex-wrap gap-2 mb-3">
                            @switch (question.Difficulty)
                            {
                                case InterviewQuestionBank.Models.DifficultyLevel.Beginner:
                                    <span class="badge badge-difficulty-beginner">
                                        <i class="fas fa-seedling"></i> Beginner
                                    </span>
                                    break;
                                case InterviewQuestionBank.Models.DifficultyLevel.Intermediate:
                                    <span class="badge badge-difficulty-intermediate">
                                        <i class="fas fa-bolt"></i> Intermediate
                                    </span>
                                    break;
                                case InterviewQuestionBank.Models.DifficultyLevel.Advanced:
                                    <span class="badge badge-difficulty-advanced">
                                        <i class="fas fa-fire"></i> Advanced
                                    </span>
                                    break;
                            }

                            @if (question.Category != null)
                            {
                                <span class="badge badge-category">
                                    <i class="fas fa-folder"></i> @question.Category.Name
                                </span>
                            }

                            @if (ViewBag.CompletedQuestionIds != null && ((List<int>)ViewBag.CompletedQuestionIds).Contains(question.Id))
                            {
                                <span class="badge badge-completed">
                                    <i class="fas fa-check-circle"></i> Completed
                                </span>
                            }
                        </div>

                        <!-- Content Preview -->
                        @if (!string.IsNullOrWhiteSpace(question.Content))
                        {
                            <p class="card-text">
                                @(question.Content.Length > 120 ? question.Content.Substring(0, 120) + "..." : question.Content)
                            </p>
                        }
                    </div>

                    <!-- Card Footer -->
                    <div class="card-footer flex items-center justify-between">
                        <span class="text-primary font-semibold">
                            View Details <i class="fas fa-arrow-right"></i>
                        </span>
                        <span class="badge badge-sm badge-neutral">
                            <i class="far fa-clock"></i> 5 min
                        </span>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="flex justify-center">
                <nav aria-label="Question pagination">
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }

                        @{
                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                            int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=1&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">
                                    @i
                                </a>
                            </li>
                        }

                        @if (endPage < ViewBag.TotalPages)
                        {
                            @if (endPage < ViewBag.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="?page=@ViewBag.TotalPages&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">@ViewBag.TotalPages</a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId&difficulty=@ViewBag.Difficulty">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card card-empty text-center py-12">
            <div class="card-body">
                <div class="flex items-center justify-center w-24 h-24 mx-auto mb-6 rounded-full bg-muted">
                    <i class="fas fa-search text-muted" style="font-size: 3rem;"></i>
                </div>
                <h3 class="text-2xl font-semibold mb-3">No Questions Found</h3>
                <p class="text-secondary mb-6 max-w-md mx-auto">
                    Try adjusting your search criteria or filters to find what you're looking for.
                </p>
                <a href="@Url.Action("Index")" class="btn btn-primary">
                    <i class="fas fa-redo"></i>
                    Reset Filters
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script>
        // Favorite toggle function
        function toggleFavorite(questionId, button) {
            fetch('/Questions/ToggleFavorite/' + questionId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    button.classList.toggle('active');
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Add animation delay to cards
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.card-question');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.05}s`;
                card.classList.add('animate-fade-in-up');
            });
        });
    </script>
}
