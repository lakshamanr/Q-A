@model InterviewQuestionBank.Models.Question
@{
    ViewData["Title"] = $"{Model.Title}";
}

<div class="container py-6">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-6">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">All Questions</a></li>
            <li class="breadcrumb-item"><a asp-action="Category" asp-route-id="@Model.CategoryId">@Model.Category.Name</a></li>
            <li class="breadcrumb-item active">Question @Model.QuestionNumber</li>
        </ol>
    </nav>

    <!-- Question Header Card -->
    <div class="card mb-6 shadow-md" style="opacity: 1 !important; transform: none !important;">
        <div class="card-gradient-primary" style="padding: var(--space-8);">
            <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4" style="color: white;">
                <div class="flex-1">
                    @if (Model.QuestionNumber.HasValue)
                    {
                        <div class="mb-3">
                            <span class="badge badge-white badge-lg">
                                <i class="fas fa-hashtag"></i> Question @Model.QuestionNumber
                            </span>
                        </div>
                    }
                    <h1 class="text-4xl font-bold mb-4" style="color: white; line-height: 1.2;">
                        <i class="fas @Model.Category.Icon"></i>
                        @Model.Title
                    </h1>
                    <div class="flex flex-wrap gap-2">
                        <span class="badge badge-white">
                            <i class="fas fa-folder"></i> @Model.Category.Name
                        </span>
                        @switch (Model.Difficulty)
                        {
                            case InterviewQuestionBank.Models.DifficultyLevel.Beginner:
                                <span class="badge badge-white">
                                    <i class="fas fa-seedling"></i> Beginner
                                </span>
                                break;
                            case InterviewQuestionBank.Models.DifficultyLevel.Intermediate:
                                <span class="badge badge-white">
                                    <i class="fas fa-bolt"></i> Intermediate
                                </span>
                                break;
                            case InterviewQuestionBank.Models.DifficultyLevel.Advanced:
                                <span class="badge badge-white">
                                    <i class="fas fa-fire"></i> Advanced
                                </span>
                                break;
                        }
                        <span class="badge badge-white">
                            <i class="far fa-clock"></i> 5 min read
                        </span>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex flex-wrap gap-2 justify-end">
                        <button type="button"
                                class="btn btn-lg btn-white @(ViewBag.IsFavorite ? "active" : "")"
                                onclick="toggleFavorite(@Model.Id)">
                            <i class="@(ViewBag.IsFavorite ? "fas" : "far") fa-heart" id="favoriteIcon"></i>
                            <span id="favoriteText" class="hidden md:inline">@(ViewBag.IsFavorite ? "Favorited" : "Favorite")</span>
                        </button>
                        <button type="button"
                                class="btn btn-lg btn-white @(ViewBag.IsCompleted ? "active" : "")"
                                onclick="toggleCompleted(@Model.Id)">
                            <i class="@(ViewBag.IsCompleted ? "fas" : "far") fa-check-circle" id="completedIcon"></i>
                            <span id="completedText" class="hidden md:inline">@(ViewBag.IsCompleted ? "Completed" : "Complete")</span>
                        </button>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-lg btn-warning" title="Edit Question">
                            <i class="fas fa-edit"></i>
                            <span class="hidden md:inline">Edit</span>
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-lg btn-danger" title="Delete Question"
                           onclick="return confirm('Are you sure you want to delete this question?')">
                            <i class="fas fa-trash"></i>
                            <span class="hidden md:inline">Delete</span>
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body">
            <!-- Question Content (Markdown Rendered) -->
            <div class="question-content prose prose-lg max-w-none">
                @if (!string.IsNullOrEmpty(Model.ContentHtml))
                {
                    @Html.Raw(Model.ContentHtml)
                }
                else
                {
                    <div class="card card-empty text-center py-12">
                        <div class="card-body">
                            <i class="fas fa-file-alt text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-4">No content available for this question.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="text-sm text-muted">
                    <i class="fas fa-calendar"></i>
                    Created: @Model.CreatedDate.ToString("MMMM dd, yyyy")
                </div>
                @if (!string.IsNullOrEmpty(Model.Tags))
                {
                    <div class="flex flex-wrap gap-2">
                        <span class="text-sm text-muted">
                            <i class="fas fa-tags"></i> Tags:
                        </span>
                        @foreach (var tag in Model.Tags.Split(','))
                        {
                            <span class="badge badge-soft-secondary badge-sm">@tag.Trim()</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Navigation to Previous/Next Questions -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
        <a asp-action="Details" asp-route-id="@(Model.Id - 1)" class="btn btn-outline-primary w-full sm:w-auto">
            <i class="fas fa-chevron-left"></i>
            Previous Question
        </a>
        <a asp-controller="Questions" asp-action="Category" asp-route-id="@Model.CategoryId" class="btn btn-outline-secondary w-full sm:w-auto">
            <i class="fas fa-list"></i>
            View All in Category
        </a>
        <a asp-action="Details" asp-route-id="@(Model.Id + 1)" class="btn btn-outline-primary w-full sm:w-auto">
            Next Question
            <i class="fas fa-chevron-right"></i>
        </a>
    </div>

    <!-- Related Questions -->
    <div class="card card-feature">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-layer-group"></i>
                More Questions in @Model.Category.Name
            </h3>
        </div>
        <div class="card-body">
            <p class="card-text mb-4">
                Explore @Model.Category.Questions.Count more questions in the @Model.Category.Name category to deepen your understanding.
            </p>
            <a asp-action="Category" asp-route-id="@Model.CategoryId" class="btn btn-primary">
                <i class="fas fa-arrow-right"></i>
                View All (@Model.Category.Questions.Count questions)
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/sql.min.js"></script>

    <script>
        // Highlight code blocks
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('pre code').forEach((block) => {
                hljs.highlightElement(block);
            });
        });

        // Toggle Favorite
        function toggleFavorite(questionId) {
            fetch(`/Questions/ToggleFavorite/${questionId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'same-origin'
            })
            .then(async response => {
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Server response:', response.status, errorText);
                    throw new Error(`Error ${response.status}: ${errorText || 'Failed to toggle favorite'}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    const icon = document.getElementById('favoriteIcon');
                    const text = document.getElementById('favoriteText');
                    if (data.isFavorite) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        text.textContent = 'Favorited';
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        text.textContent = 'Favorite';
                    }
                }
            })
            .catch(error => {
                console.error('Error toggling favorite:', error);
                alert(error.message || 'An error occurred while toggling favorite');
            });
        }

        // Toggle Completed
        function toggleCompleted(questionId) {
            fetch(`/Questions/ToggleCompleted/${questionId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'same-origin'
            })
            .then(async response => {
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Server response:', response.status, errorText);
                    throw new Error(`Error ${response.status}: ${errorText || 'Failed to toggle completion'}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    const icon = document.getElementById('completedIcon');
                    const text = document.getElementById('completedText');
                    if (data.isCompleted) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        text.textContent = 'Completed';
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        text.textContent = 'Mark Complete';
                    }
                }
            })
            .catch(error => {
                console.error('Error toggling completion:', error);
                alert(error.message || 'An error occurred while toggling completion');
            });
        }
    </script>

    <style>
        .question-content {
            line-height: var(--line-height-relaxed);
            font-size: var(--font-size-base);
            color: var(--text-primary);
        }

        .question-content h2 {
            color: var(--text-primary);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-bold);
            margin-top: var(--space-8);
            margin-bottom: var(--space-4);
            padding-bottom: var(--space-2);
            border-bottom: 2px solid var(--border-color);
        }

        .question-content h3 {
            color: var(--text-primary);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-semibold);
            margin-top: var(--space-6);
            margin-bottom: var(--space-3);
        }

        .question-content h4 {
            color: var(--text-primary);
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            margin-top: var(--space-4);
            margin-bottom: var(--space-2);
        }

        .question-content p {
            margin-bottom: var(--space-4);
        }

        .question-content pre {
            background-color: #282c34;
            padding: var(--space-4);
            border-radius: var(--radius-lg);
            overflow-x: auto;
            margin: var(--space-4) 0;
            box-shadow: var(--shadow-sm);
        }

        .question-content code {
            background-color: var(--color-neutral-100);
            padding: 0.125rem 0.375rem;
            border-radius: var(--radius-sm);
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            color: var(--color-error-700);
        }

        [data-theme="dark"] .question-content code {
            background-color: var(--color-dark-700);
            color: var(--color-error-300);
        }

        .question-content pre code {
            background-color: transparent;
            padding: 0;
            color: #abb2bf;
            font-size: var(--font-size-sm);
        }

        .question-content table {
            width: 100%;
            margin: var(--space-4) 0;
            border-collapse: collapse;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .question-content table th,
        .question-content table td {
            padding: var(--space-3);
            border: 1px solid var(--border-color);
            text-align: left;
        }

        .question-content table th {
            background-color: var(--bg-muted);
            font-weight: var(--font-weight-semibold);
            color: var(--text-primary);
        }

        .question-content ul,
        .question-content ol {
            margin-left: var(--space-6);
            margin-bottom: var(--space-4);
        }

        .question-content li {
            margin-bottom: var(--space-2);
        }

        .question-content blockquote {
            border-left: 4px solid var(--color-primary-600);
            padding-left: var(--space-4);
            margin-left: 0;
            margin: var(--space-4) 0;
            color: var(--text-secondary);
            font-style: italic;
            background-color: var(--bg-muted);
            padding: var(--space-4);
            border-radius: var(--radius-md);
        }

        .question-content img {
            max-width: 100%;
            height: auto;
            border-radius: var(--radius-lg);
            margin: var(--space-4) 0;
            box-shadow: var(--shadow-md);
        }

        .question-content a {
            color: var(--color-primary-600);
            text-decoration: underline;
            transition: var(--transition-colors);
        }

        .question-content a:hover {
            color: var(--color-primary-700);
        }

        .question-content hr {
            border: none;
            border-top: 2px solid var(--border-color);
            margin: var(--space-8) 0;
        }
    </style>
}
