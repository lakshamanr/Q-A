@model InterviewQuestionBank.Models.Question
@{
    ViewData["Title"] = "Delete Question";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="background: transparent; padding: 0;">
            <li class="breadcrumb-item"><a asp-action="Index" style="color: var(--brand-primary);">All Questions</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
            <li class="breadcrumb-item active">Delete</li>
        </ol>
    </nav>

    <!-- Delete Confirmation Card -->
    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>Delete Question
            </h3>
        </div>
        <div class="card-body">
            <!-- Warning Message -->
            <div class="alert alert-danger d-flex align-items-start mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-3 mt-1" style="font-size: 1.5rem;"></i>
                <div>
                    <h5 class="alert-heading mb-2">Are you sure you want to delete this question?</h5>
                    <p class="mb-0">This action cannot be undone. All associated data including user favorites and progress will be permanently removed.</p>
                </div>
            </div>

            <!-- Question Details -->
            <div class="mb-4">
                <h4 class="mb-3">Question Details:</h4>

                <dl class="row mb-0">
                    @if (Model.QuestionNumber.HasValue)
                    {
                        <dt class="col-sm-3">Question Number</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-secondary">
                                <i class="fas fa-hashtag"></i> @Model.QuestionNumber
                            </span>
                        </dd>
                    }

                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9">
                        <strong>@Model.Title</strong>
                    </dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">
                        <span class="badge" style="background-color: @Model.Category.ColorCode; color: white;">
                            <i class="fas @Model.Category.Icon me-1"></i>@Model.Category.Name
                        </span>
                    </dd>

                    <dt class="col-sm-3">Difficulty</dt>
                    <dd class="col-sm-9">
                        @switch (Model.Difficulty)
                        {
                            case InterviewQuestionBank.Models.DifficultyLevel.Beginner:
                                <span class="badge bg-success">
                                    <i class="fas fa-seedling me-1"></i>Beginner
                                </span>
                                break;
                            case InterviewQuestionBank.Models.DifficultyLevel.Intermediate:
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-bolt me-1"></i>Intermediate
                                </span>
                                break;
                            case InterviewQuestionBank.Models.DifficultyLevel.Advanced:
                                <span class="badge bg-danger">
                                    <i class="fas fa-fire me-1"></i>Advanced
                                </span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-3">Created Date</dt>
                    <dd class="col-sm-9">
                        <i class="fas fa-calendar me-1"></i>@Model.CreatedDate.ToString("MMMM dd, yyyy")
                    </dd>

                    @if (Model.ViewCount > 0)
                    {
                        <dt class="col-sm-3">View Count</dt>
                        <dd class="col-sm-9">
                            <i class="fas fa-eye me-1"></i>@Model.ViewCount views
                        </dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Tags))
                    {
                        <dt class="col-sm-3">Tags</dt>
                        <dd class="col-sm-9">
                            @foreach (var tag in Model.Tags.Split(','))
                            {
                                <span class="badge bg-secondary me-1">@tag.Trim()</span>
                            }
                        </dd>
                    }
                </dl>
            </div>

            <!-- Content Preview -->
            <div class="mb-4">
                <h5 class="mb-2">Content Preview:</h5>
                <div class="border rounded p-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                    @if (!string.IsNullOrEmpty(Model.ContentHtml))
                    {
                        @Html.Raw(Model.ContentHtml.Length > 500
                            ? Model.ContentHtml.Substring(0, 500) + "..."
                            : Model.ContentHtml)
                    }
                    else if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <p>@(Model.Content.Length > 500
                            ? Model.Content.Substring(0, 500) + "..."
                            : Model.Content)</p>
                    }
                    else
                    {
                        <p class="text-muted">No content available</p>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <hr />
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash me-2"></i>Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Additional Information -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h6 class="mb-3">
                <i class="fas fa-info-circle me-2"></i>What happens when you delete this question?
            </h6>
            <ul class="mb-0">
                <li>The question and its content will be permanently removed from the database</li>
                <li>All user favorites for this question will be deleted</li>
                <li>All user progress records for this question will be deleted</li>
                <li>This action cannot be undone or recovered</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .alert-danger {
        border-left: 4px solid #dc3545;
    }

    .card.border-danger {
        border-width: 2px;
    }

    dl.row dt {
        font-weight: 600;
        color: var(--text-secondary, #525252);
        margin-bottom: 0.75rem;
    }

    dl.row dd {
        margin-bottom: 0.75rem;
    }

    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
    }
</style>
