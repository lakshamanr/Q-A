@model ImportVerificationViewModel
@{
    ViewData["Title"] = "Verify Import";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-check-circle"></i> Import Verification</h1>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-primary">@Model.TotalQuestions</h2>
                    <p class="text-muted mb-0">Total Questions Imported</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="@(Model.MissingCount == 0 ? "text-success" : "text-warning")">@Model.MissingCount</h2>
                    <p class="text-muted mb-0">Missing Questions</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-info">@Model.QuestionNumberRange</h3>
                    <p class="text-muted mb-0">Question Range</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.MissingCount > 0)
    {
        <div class="alert alert-warning">
            <h5><i class="fas fa-exclamation-triangle"></i> Missing Questions Found</h5>
            <p class="mb-2">The following question numbers are missing from the database:</p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var missing in Model.MissingQuestions)
                {
                    <span class="badge bg-warning">@missing</span>
                }
            </div>
        </div>
    }
    else if (Model.TotalQuestions > 0)
    {
        <div class="alert alert-success">
            <h5><i class="fas fa-check"></i> No Gaps Found!</h5>
            <p class="mb-0">All questions from @Model.QuestionNumberRange are present in the database.</p>
        </div>
    }

    <!-- Category Breakdown -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-list"></i> Questions by Category</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Actual Count</th>
                            <th>Expected Range</th>
                            <th>Expected Count</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.CategoryBreakdown)
                        {
                            var isComplete = cat.QuestionCount >= cat.ExpectedCount;
                            var percentage = cat.ExpectedCount > 0 ? (cat.QuestionCount * 100.0 / cat.ExpectedCount) : 0;
                            <tr>
                                <td>@cat.CategoryName</td>
                                <td><span class="badge bg-primary">@cat.QuestionCount</span></td>
                                <td>@cat.ExpectedRange</td>
                                <td>@cat.ExpectedCount</td>
                                <td>
                                    @if (isComplete)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Complete</span>
                                    }
                                    else if (percentage >= 50)
                                    {
                                        <span class="badge bg-warning"><i class="fas fa-exclamation"></i> Partial (@percentage.ToString("F0")%)</span>
                                    }
                                    else if (cat.QuestionCount > 0)
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times"></i> Incomplete (@percentage.ToString("F0")%)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-minus"></i> Empty</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Difficulty Breakdown -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Questions by Difficulty</h5>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var diff in Model.DifficultyBreakdown)
                {
                    var percentage = Model.TotalQuestions > 0 ? (diff.Count * 100.0 / Model.TotalQuestions) : 0;
                    var colorClass = diff.Difficulty switch
                    {
                        "Beginner" => "success",
                        "Intermediate" => "warning",
                        "Advanced" => "danger",
                        _ => "secondary"
                    };
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <h4 class="text-@colorClass">@diff.Count</h4>
                                <p class="mb-1">@diff.Difficulty</p>
                                <small class="text-muted">(@percentage.ToString("F1")%)</small>
                                <div class="progress mt-2" style="height: 10px;">
                                    <div class="progress-bar bg-@colorClass" role="progressbar" style="width: @percentage%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-primary">
            <i class="fas fa-file-import"></i> Import More Questions
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <a asp-controller="Questions" asp-action="Index" class="btn btn-info">
            <i class="fas fa-list"></i> Browse Questions
        </a>
    </div>
</div>
