@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Hero Section -->
<div class="admin-hero-section mb-5 fade-in">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="admin-hero-title mb-3">
                <i class="fas fa-tachometer-alt me-3"></i>Admin Dashboard
            </h1>
            <p class="admin-hero-subtitle mb-0">
                Manage and monitor your interview question bank with powerful analytics and insights
            </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <div class="admin-timestamp">
                <i class="fas fa-clock me-2"></i>
                <span id="currentDateTime"></span>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3 fade-in stagger-1">
        <div class="stats-card stats-card-primary">
            <div class="stats-card-icon">
                <i class="fas fa-question-circle"></i>
            </div>
            <div class="stats-card-content">
                <h3 class="stats-card-value" data-count="@Model.TotalQuestions">0</h3>
                <p class="stats-card-label">Total Questions</p>
            </div>
            <div class="stats-card-badge">
                <i class="fas fa-arrow-up me-1"></i>Active
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 fade-in stagger-2">
        <div class="stats-card stats-card-success">
            <div class="stats-card-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stats-card-content">
                <h3 class="stats-card-value" data-count="@Model.PublishedQuestions">0</h3>
                <p class="stats-card-label">Published</p>
            </div>
            <div class="stats-card-badge">
                <i class="fas fa-globe me-1"></i>Live
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 fade-in stagger-3">
        <div class="stats-card stats-card-info">
            <div class="stats-card-icon">
                <i class="fas fa-folder-open"></i>
            </div>
            <div class="stats-card-content">
                <h3 class="stats-card-value" data-count="@Model.TotalCategories">0</h3>
                <p class="stats-card-label">Categories</p>
            </div>
            <div class="stats-card-badge">
                <i class="fas fa-layer-group me-1"></i>Groups
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 fade-in stagger-4">
        <div class="stats-card stats-card-warning">
            <div class="stats-card-icon">
                <i class="fas fa-eye"></i>
            </div>
            <div class="stats-card-content">
                <h3 class="stats-card-value" data-count="@Model.TotalViews">0</h3>
                <p class="stats-card-label">Total Views</p>
            </div>
            <div class="stats-card-badge">
                <i class="fas fa-chart-line me-1"></i>Tracked
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card action-card mb-5 fade-in stagger-5">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-bolt me-2"></i>Quick Actions
        </h5>
        <p class="text-muted small mb-0 mt-2">Perform common administrative tasks</p>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <a asp-action="Import" class="action-btn action-btn-primary">
                    <div class="action-btn-icon">
                        <i class="fas fa-file-import"></i>
                    </div>
                    <div class="action-btn-content">
                        <h6>Import Questions</h6>
                        <p>Bulk import from file</p>
                    </div>
                    <i class="fas fa-arrow-right action-btn-arrow"></i>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a asp-action="VerifyImport" class="action-btn action-btn-info">
                    <div class="action-btn-icon">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <div class="action-btn-content">
                        <h6>Verify Import</h6>
                        <p>Check data integrity</p>
                    </div>
                    <i class="fas fa-arrow-right action-btn-arrow"></i>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Questions" asp-action="Index" class="action-btn action-btn-secondary">
                    <div class="action-btn-icon">
                        <i class="fas fa-list-ul"></i>
                    </div>
                    <div class="action-btn-content">
                        <h6>Browse Questions</h6>
                        <p>View all questions</p>
                    </div>
                    <i class="fas fa-arrow-right action-btn-arrow"></i>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Questions" asp-action="Create" class="action-btn action-btn-success">
                    <div class="action-btn-icon">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    <div class="action-btn-content">
                        <h6>Create Question</h6>
                        <p>Add new question</p>
                    </div>
                    <i class="fas fa-arrow-right action-btn-arrow"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Category Statistics -->
<div class="card category-stats-card fade-in stagger-6">
    <div class="card-header">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar me-2"></i>Questions by Category
                </h5>
                <p class="text-muted small mb-0 mt-2">Track progress across all categories</p>
            </div>
            <div class="category-stats-summary">
                <span class="badge badge-primary">@Model.CategoryStats.Count Categories</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table category-stats-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-tag me-2"></i>Category</th>
                        <th><i class="fas fa-hashtag me-2"></i>Count</th>
                        <th><i class="fas fa-ruler me-2"></i>Range</th>
                        <th><i class="fas fa-chart-line me-2"></i>Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in Model.CategoryStats)
                    {
                        var expectedCount = stat.RangeEnd - stat.RangeStart + 1;
                        var percentage = expectedCount > 0 ? (stat.QuestionCount * 100.0 / expectedCount) : 0;
                        var progressClass = percentage >= 100 ? "progress-complete" : percentage >= 75 ? "progress-good" : percentage >= 50 ? "progress-medium" : "progress-low";
                        
                        <tr class="category-row">
                            <td>
                                <div class="category-name-cell">
                                    <div class="category-icon">
                                        <i class="fas fa-layer-group"></i>
                                    </div>
                                    <span class="fw-semibold">@stat.CategoryName</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-count">@stat.QuestionCount</span>
                            </td>
                            <td>
                                <span class="range-badge">Q@stat.RangeStart - Q@stat.RangeEnd</span>
                            </td>
                            <td>
                                <div class="progress-cell">
                                    <div class="progress modern-progress">
                                        <div class="progress-bar @progressClass" 
                                             role="progressbar" 
                                             style="width: @Math.Min(percentage, 100)%" 
                                             aria-valuenow="@percentage" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="progress-info">
                                        <span class="progress-text">@stat.QuestionCount / @expectedCount</span>
                                        <span class="progress-percentage">@percentage.ToString("F1")%</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Animated counter for statistics
        document.addEventListener('DOMContentLoaded', function() {
            const counters = document.querySelectorAll('.stats-card-value[data-count]');
            
            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-count'));
                const duration = 2000;
                const increment = target / (duration / 16);
                let current = 0;
                
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        counter.textContent = target.toLocaleString();
                        clearInterval(timer);
                    } else {
                        counter.textContent = Math.floor(current).toLocaleString();
                    }
                }, 16);
            });

            // Update current date/time
            function updateDateTime() {
                const now = new Date();
                const options = { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                };
                document.getElementById('currentDateTime').textContent = now.toLocaleDateString('en-US', options);
            }
            updateDateTime();
            setInterval(updateDateTime, 60000);
        });
    </script>
}
