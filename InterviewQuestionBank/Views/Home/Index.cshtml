@model List<InterviewQuestionBank.Models.Category>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section - Modern Design with New Components -->
<div class="hero hero-gradient hero-lg hero-pattern">
    <div class="hero-content hero-centered">
        <div class="hero-badge">
            <i class="fas fa-star"></i>
            <span>570+ Interview Questions</span>
        </div>

        <h1 class="hero-title">
            Master Your .NET Interview
        </h1>

        <p class="hero-subtitle">
            Comprehensive questions and answers covering .NET Core, ASP.NET, Azure, Microservices, SQL Server, and more.
            Build confidence with practical, real-world scenarios.
        </p>

        <!-- Hero Stats -->
        <div class="hero-stats">
            <div class="hero-stat">
                <div class="hero-stat-value">
                    <i class="fas fa-question-circle"></i> @ViewBag.TotalQuestions
                </div>
                <div class="hero-stat-label">Questions</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-value">
                    <i class="fas fa-layer-group"></i> @ViewBag.TotalCategories
                </div>
                <div class="hero-stat-label">Topics</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-value">
                    <i class="fas fa-chart-line"></i> @ViewBag.TotalViews
                </div>
                <div class="hero-stat-label">Total Views</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-value">
                    <i class="fas fa-check-circle"></i> 100%
                </div>
                <div class="hero-stat-label">Practical</div>
            </div>
        </div>

        <!-- Hero Actions -->
        <div class="hero-actions">
            <a asp-controller="Questions" asp-action="Index" class="btn btn-lg btn-white">
                <i class="fas fa-book-open"></i>
                Browse All Questions
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-lg btn-outline-white">
                    <i class="fas fa-rocket"></i>
                    Get Started Free
                </a>
            }
        </div>
    </div>
</div>

<!-- Categories Section -->
<div class="container py-12">
    <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-3">Question Categories</h2>
        <p class="text-xl text-secondary">Comprehensive coverage of all essential topics</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var category in Model)
        {
            <div class="card card-interactive card-elevated">
                <div class="card-body">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="flex items-center justify-center w-16 h-16 rounded-lg" style="background-color: @category.ColorCode;">
                            <i class="fas @category.Icon text-white text-2xl"></i>
                        </div>
                        <div class="flex-1">
                            <h3 class="card-title mb-1">@category.Name</h3>
                            <span class="badge badge-sm badge-neutral">Q@category.QuestionRangeStart - Q@category.QuestionRangeEnd</span>
                        </div>
                    </div>

                    <p class="card-text mb-4">@category.Description</p>

                    <div class="flex items-center justify-between pt-4" style="border-top: 1px solid var(--border-color);">
                        <span class="badge badge-primary">
                            <i class="fas fa-book"></i>
                            @category.Questions.Count Questions
                        </span>
                        <a asp-controller="Questions" asp-action="Category" asp-route-id="@category.Id" class="btn btn-sm btn-primary">
                            View <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Features Section -->
<div class="container py-16" style="background-color: var(--bg-muted); border-radius: var(--radius-2xl); margin-bottom: var(--space-12);">
    <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-3">Why Choose Our Platform?</h2>
        <p class="text-xl text-secondary">Everything you need to succeed in your .NET interviews</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
            <div class="flex items-center justify-center w-20 h-20 mx-auto mb-4 rounded-full" style="background: var(--gradient-primary);">
                <i class="fas fa-code text-white text-3xl"></i>
            </div>
            <h3 class="text-xl font-semibold mb-3">Practical Code Examples</h3>
            <p class="text-secondary">Every question includes real-world C# code examples you can learn from and practice with.</p>
        </div>

        <div class="text-center">
            <div class="flex items-center justify-center w-20 h-20 mx-auto mb-4 rounded-full" style="background: var(--gradient-secondary);">
                <i class="fas fa-check-circle text-white text-3xl"></i>
            </div>
            <h3 class="text-xl font-semibold mb-3">Industry Best Practices</h3>
            <p class="text-secondary">Learn industry-standard patterns, approaches, and techniques used by top developers.</p>
        </div>

        <div class="text-center">
            <div class="flex items-center justify-center w-20 h-20 mx-auto mb-4 rounded-full" style="background: var(--gradient-accent);">
                <i class="fas fa-chart-line text-white text-3xl"></i>
            </div>
            <h3 class="text-xl font-semibold mb-3">Track Your Progress</h3>
            <p class="text-secondary">Monitor your learning journey, mark favorites, and track completed questions.</p>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="container pb-12">
    <div class="card card-gradient-primary p-12 text-center">
        <h2 class="text-3xl font-bold mb-4" style="color: white;">Ready to Ace Your Interview?</h2>
        <p class="text-xl mb-6" style="color: rgba(255, 255, 255, 0.95);">
            Join thousands of developers who have successfully prepared for their .NET interviews using our platform.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
            <a asp-controller="Questions" asp-action="Index" class="btn btn-lg btn-white">
                <i class="fas fa-book-open"></i>
                Start Learning Now
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-lg btn-outline-white">
                    <i class="fas fa-user-plus"></i>
                    Create Free Account
                </a>
            }
        </div>
    </div>
</div>
